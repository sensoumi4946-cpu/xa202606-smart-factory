# XA-202606 Smart Factory Platform — Environment Variables
# Copy to .env and adjust for your local setup.

# MQTT Broker
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# OPC UA Simulator / Adapter
OPCUA_ENDPOINT=opc.tcp://localhost:4840/
OPCUA_DEVICE_ID=sensor_hcsr04_01
OPCUA_DISTANCE_NODE_ID=ns=2;s=distance
OPCUA_SIM_PORT=4840
OPCUA_UPDATE_INTERVAL=2

# Backend API
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_PATH=data/smart_factory.db

# Dashboard (Vite dev server)
DASHBOARD_PORT=5173

# Mock Generator
MOCK_INTERVAL=2.0
