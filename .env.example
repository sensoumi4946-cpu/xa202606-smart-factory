# XA-202606 Smart Factory Platform — Environment Variables
# Copy to .env and adjust for your local setup.

# MQTT Broker
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# Backend API
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_PATH=data/smart_factory.db

# REST Adapter
REST_ADAPTER_PORT=8100
REST_ADAPTER_URL=http://localhost:8100/adapter/rest/ingest
REST_PUSH_INTERVAL=2

# Dashboard (Vite dev server)
DASHBOARD_PORT=5173

# Mock Generator
MOCK_INTERVAL=2.0
