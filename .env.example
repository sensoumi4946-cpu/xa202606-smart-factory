# XA-202606 Smart Factory Platform — Environment Variables
# Copy to .env and adjust for your local setup.

# MQTT Broker
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# Modbus Simulator / Adapter
MODBUS_HOST=localhost
MODBUS_PORT=1502
MODBUS_DEVICE_ID=sensor_mq2_01
MODBUS_POLL_INTERVAL=2
MODBUS_SIM_PORT=1502
MODBUS_UPDATE_INTERVAL=2

# Backend API
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_PATH=data/smart_factory.db

# REST Adapter
REST_ADAPTER_PORT=8100
REST_ADAPTER_URL=http://localhost:8100/adapter/rest/ingest
REST_PUSH_INTERVAL=2

# OPC UA Adapter / Simulator
OPCUA_ENDPOINT=opc.tcp://localhost:4840/
OPCUA_DEVICE_ID=sensor_hcsr04_01
OPCUA_DISTANCE_NODE_ID=ns=2;s=distance
OPCUA_SIM_PORT=4840
OPCUA_UPDATE_INTERVAL=2

# Dashboard (Vite dev server)
DASHBOARD_PORT=5173

# Fuseki / Semantic Layer
FUSEKI_PORT=3030
FUSEKI_ENDPOINT=http://localhost:3030/factory/data
FUSEKI_QUERY_URL=http://localhost:3030/factory/sparql
SEMANTIC_WRITE_ENABLED=true

# Mock Generator
MOCK_INTERVAL=2.0
