# XA-202606 Smart Factory Platform — Environment Variables
# Copy to .env and adjust for your local setup.

# MQTT Broker
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# Modbus Simulator / Adapter
MODBUS_HOST=localhost
MODBUS_PORT=1502
MODBUS_DEVICE_ID=sensor_mq2_01
MODBUS_POLL_INTERVAL=2
MODBUS_SIM_PORT=1502
MODBUS_UPDATE_INTERVAL=2

# Backend API
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_PATH=data/smart_factory.db

# Dashboard (Vite dev server)
DASHBOARD_PORT=5173

# Mock Generator
MOCK_INTERVAL=2.0
