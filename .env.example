# XA-202606 Smart Factory Platform — Environment Variables
# Copy to .env and adjust for your local setup.

# MQTT Broker
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# Modbus Simulator / Adapter
MODBUS_HOST=localhost
MODBUS_PORT=1502
MODBUS_POLL_INTERVAL=2

# Backend API
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_PATH=data/smart_factory.db
PROVENANCE_AUDIT_DB=data/prov_audit.db
PUBLIC_BACKEND_URL=http://localhost:8000
BACKEND_URL=http://localhost:8000
BINDINGS_TTL=bindings.ttl
THRESHOLDS_TTL=thresholds.ttl

# REST Adapter
REST_ADAPTER_PORT=8100
REST_ADAPTER_URL=http://localhost:8100/adapter/rest/ingest

# OPC UA Adapter / Simulator
OPCUA_ENDPOINT=opc.tcp://localhost:4840/
# Production example:
# OPCUA_SECURITY_STRING=Basic256Sha256,SignAndEncrypt,client-cert.pem,client-key.pem,server-cert.pem
OPCUA_SECURITY_STRING=
OPCUA_USERNAME=
OPCUA_PASSWORD=
OPCUA_USER_CERTIFICATE=
OPCUA_USER_PRIVATE_KEY=
OPCUA_USER_PRIVATE_KEY_PASSWORD=

# Dashboard (Vite dev server)
DASHBOARD_PORT=5173

# Fuseki / Semantic Layer
FUSEKI_PORT=3030
FUSEKI_ENDPOINT=http://localhost:3030/factory/data
FUSEKI_QUERY_URL=http://localhost:3030/factory/sparql
SEMANTIC_WRITE_ENABLED=true

# Mock Generator
API_KEY=replace-with-a-random-secret
COMMAND_SIGNING_KEY=replace-with-a-different-random-secret
HARDWARE_PROFILE=mock
MOCK_INTERVAL=2.0
