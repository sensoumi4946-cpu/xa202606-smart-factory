sf:binding_ir_count a sf:ProtocolBinding ;
    sf:bindsProperty sf:measuresCount ;
    sf:transportProtocol "rest" ;
    sf:deviceId "ESP32_002" ;
    sf:deviceAlias "ESP32_002_ir" ;
    sf:deviceAlias "esp32_03_ir";
    sf:belongsToSubsystem sf:CountingSubsystem ;
    sf:hasUnit "count" ;
    sf:restPath "/ingest/api/v1/data" ;
    sf:restMethod "POST" ;
    sf:scaleFactor "1.0"^^xsd:double ;
    sf:pollIntervalMs 2000 .

sf:binding_pir_occupancy a sf:ProtocolBinding ;
    sf:bindsProperty sf:measuresOccupancy ;
    sf:transportProtocol "rest" ;
    sf:deviceId "ESP32_003" ;
    sf:deviceAlias "ESP32_003_pir" ;
    sf:deviceAlias "esp32_04_pir";
    sf:belongsToSubsystem sf:LightingSubsystem ;
    sf:hasUnit "boolean" ;
    sf:restPath "/ingest/api/v1/data" ;
    sf:restMethod "POST" ;
    sf:scaleFactor "1.0"^^xsd:double ;
    sf:pollIntervalMs 2000 .

sf:binding_relay_light_state a sf:ProtocolBinding ;
