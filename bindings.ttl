sf:binding_dht22_mqtt_temperature a sf:ProtocolBinding ;
    sf:bindsProperty sf:measuresTemperature ;
    sf:transportProtocol "mqtt" ;
    sf:deviceId "ESP32_001" ;
    sf:deviceAlias "ESP32_001_dht22" ;
    sf:deviceAlias "esp32_05_dht22";
    sf:belongsToSubsystem sf:TempHumiditySubsystem ;
    sf:hasUnit "celsius" ;
    sf:mqttTopic "factory/temp_humidity/sensors/ESP32_001/temperature" ;
    sf:mqttQos 1 ;
    sf:scaleFactor "1.0"^^xsd:double ;
    sf:pollIntervalMs 2000 .

sf:binding_dht22_mqtt_humidity a sf:ProtocolBinding ;
    sf:bindsProperty sf:measuresHumidity ;
    sf:transportProtocol "mqtt" ;
    sf:deviceId "ESP32_001" ;
    sf:deviceAlias "ESP32_001_dht22" ;
    sf:belongsToSubsystem sf:TempHumiditySubsystem ;
    sf:hasUnit "percent" ;
    sf:mqttTopic "factory/temp_humidity/sensors/ESP32_001/humidity" ;
    sf:mqttQos 1 ;
    sf:scaleFactor "1.0"^^xsd:double ;
    sf:pollIntervalMs 2000 .

sf:binding_dht22_opcua_temperature a sf:ProtocolBinding ;
    sf:bindsProperty sf:measuresTemperature ;
    sf:transportProtocol "opcua" ;
    sf:deviceId "ESP32_001" ;
    sf:deviceAlias "ESP32_001_dht22" ;
    sf:belongsToSubsystem sf:TempHumiditySubsystem ;
    sf:hasUnit "celsius" ;
    sf:nodeId "TempHumidity.Temperature" ;
    sf:namespaceIndex 2 ;
    sf:scaleFactor "1.0"^^xsd:double ;
    sf:pollIntervalMs 2000 .

sf:binding_dht22_opcua_humidity a sf:ProtocolBinding ;
