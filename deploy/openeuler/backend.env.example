# Copy to /etc/xa202606/backend.env and replace every CHANGE_ME value.
API_KEY=CHANGE_ME_LONG_RANDOM_API_KEY
COMMAND_SIGNING_KEY=CHANGE_ME_INDEPENDENT_LONG_RANDOM_SIGNING_KEY
HARDWARE_PROFILE=real
SEMANTIC_WRITE_ENABLED=false
PUBLIC_BACKEND_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://127.0.0.1:5173
LATEST_WINDOW_MINUTES=30

# Enable only when Fuseki is installed and reachable.
FUSEKI_ENDPOINT=http://127.0.0.1:3030/factory/data
FUSEKI_QUERY_URL=http://127.0.0.1:3030/factory/sparql
