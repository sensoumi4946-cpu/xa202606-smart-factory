BACKEND_URL=http://127.0.0.1:8000
API_KEY=CHANGE_ME_SAME_AS_BACKEND_API_KEY
RECONNECT_INTERVAL=5

MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883

MODBUS_HOST=127.0.0.1
MODBUS_PORT=1502
MODBUS_POLL_INTERVAL=2

REST_ADAPTER_PORT=8100

OPCUA_ENDPOINT=opc.tcp://127.0.0.1:4840/
# Production example. Paths are read by the xa202606 service account.
OPCUA_SECURITY_STRING=Basic256Sha256,SignAndEncrypt,/etc/xa202606/certificates/client-cert.pem,/etc/xa202606/certificates/client-key.pem,/etc/xa202606/certificates/server-cert.pem
OPCUA_USERNAME=
OPCUA_PASSWORD=
OPCUA_USER_CERTIFICATE=/etc/xa202606/certificates/client-cert.pem
OPCUA_USER_PRIVATE_KEY=/etc/xa202606/certificates/client-key.pem
OPCUA_USER_PRIVATE_KEY_PASSWORD=

AGV_SERIAL_DEVICE=/dev/ttyUSB0
AGV_SERIAL_BAUD=115200
AGV_OPCUA_ENDPOINT=opc.tcp://0.0.0.0:4840/
AGV_OPCUA_CERTIFICATE=/etc/xa202606/certificates/server-cert.pem
AGV_OPCUA_PRIVATE_KEY=/etc/xa202606/certificates/server-key.pem
AGV_OPCUA_ALLOW_INSECURE=false
