[Unit]
Description=XA-202606 %i protocol adapter
After=network-online.target xa202606-backend.service
Wants=network-online.target
Requires=xa202606-backend.service

[Service]
Type=simple
User=xa202606
Group=xa202606
WorkingDirectory=/opt/xa202606
EnvironmentFile=-/etc/xa202606/connectivity.env
Environment=BINDINGS_TTL=/etc/xa202606/bindings.ttl
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/xa202606/venv/bin/python -m connectivity.runner --adapter %i
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=512M

[Install]
WantedBy=multi-user.target
