<file path="deploy/fuseki/shiro.ini">
# Fuseki security configuration — DEVELOPMENT ONLY.
#
# Grants anonymous access to every endpoint, including the admin API and the
# /factory dataset, so the backend container can POST triples and run SPARQL
# without credentials. This removes Fuseki's default localhost-only guard on
# the /$/ admin endpoints. Do NOT reuse this in production.
[main]
plainMatcher = org.apache.shiro.authc.credential.SimpleCredentialsMatcher
iniRealm.credentialsMatcher = $plainMatcher

[users]
admin = smart-factory

[roles]

[urls]
## Allow anonymous access to all endpoints for local development.
/$/ping    = anon
/$/**      = anon
/**        = anon
</file>

