<file path="semantic-layer/src/semantic_layer/ontology/saref-alignment.ttl">
@prefix sf:     <http://example.org/smart-factory#> .
@prefix saref:  <https://saref.etsi.org/core/> .
@prefix s4envi: <https://saref.etsi.org/saref4envi/> .
@prefix sosa:   <http://www.w3.org/ns/sosa/> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .

# Sensor class alignment
# SAREF defines saref:Sensor as a subclass of sosa:Sensor.
# Sensor classes are already sosa:Sensor subclasses (via the ontology),
# so these mappings complete the chain: sf:X → sosa:Sensor → saref:Sensor.

sf:TemperatureSensor  rdfs:subClassOf  saref:Sensor ;
    skos:closeMatch  saref:TemperatureSensor .

sf:HumiditySensor     rdfs:subClassOf  saref:Sensor ;
    skos:closeMatch  saref:HumiditySensor .

sf:GasSensor          rdfs:subClassOf  saref:Sensor .

sf:ProximitySensor    rdfs:subClassOf  saref:Sensor .

sf:CountSensor        rdfs:subClassOf  saref:Sensor .

sf:OccupancySensor    rdfs:subClassOf  saref:Sensor .

# Observable property alignment
#
# SAREF core treats Temperature and Humidity as named Property instances.
# Use owl:equivalentProperty where the match is exact and
# skos:closeMatch where the mapping is approximate (e.g. CO ≈ air emission).

sf:measuresTemperature  owl:equivalentProperty  saref:measuresTemperature ;
    skos:exactMatch  saref:Temperature .

sf:measuresHumidity     owl:equivalentProperty  saref:measuresHumidity ;
    skos:exactMatch  saref:Humidity .

sf:measuresCO           skos:closeMatch  s4envi:CO2Concentration .

sf:measuresSmoke        skos:closeMatch  s4envi:PM10Concentration .

sf:measuresCombustibleGas  skos:broadMatch  s4envi:AirQuality .

# Subsystem alignment
# SAREF4BLDG covers building systems; factory subsystems map approximately.

sf:TempHumiditySubsystem   skos:closeMatch  <https://saref.etsi.org/saref4bldg/HVAC> .
sf:GasMonitoringSubsystem  skos:closeMatch  <https://saref.etsi.org/saref4bldg/FireDetectionSystem> .
sf:LightingSubsystem       skos:closeMatch  <https://saref.etsi.org/saref4bldg/Lighting> .
</file>

<file path="semantic-layer/src/semantic_layer/ontology/smart-factory.ttl">
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix ssn:  <http://www.w3.org/ns/ssn/> .
@prefix sf:   <http://example.org/smart-factory#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .

@base <http://example.org/smart-factory> .

# ── Sensor classes (5 subsystems) ──

sf:TemperatureSensor  a  owl:Class ;
    rdfs:subClassOf  sosa:Sensor ;
    rdfs:label        "Temperature Sensor"@en ;
    rdfs:comment      "Measures ambient temperature in the factory environment"@en .

sf:HumiditySensor  a  owl:Class ;
    rdfs:subClassOf  sosa:Sensor ;
    rdfs:label        "Humidity Sensor"@en ;
    rdfs:comment      "Measures relative humidity in the factory environment"@en .

sf:GasSensor  a  owl:Class ;
    rdfs:subClassOf  sosa:Sensor ;
    rdfs:label        "Gas Sensor"@en ;
    rdfs:comment      "Detects hazardous gases (smoke, CO, combustible gas)"@en .

sf:ProximitySensor  a  owl:Class ;
    rdfs:subClassOf  sosa:Sensor ;
    rdfs:label        "Proximity / Distance Sensor"@en ;
    rdfs:comment      "Measures distance for AGV obstacle avoidance"@en .

sf:CountSensor  a  owl:Class ;
    rdfs:subClassOf  sosa:Sensor ;
    rdfs:label        "Counting Sensor"@en ;
    rdfs:comment      "Counts goods passing on the production line"@en .

sf:OccupancySensor  a  owl:Class ;
    rdfs:subClassOf  sosa:Sensor ;
    rdfs:label        "Occupancy Sensor"@en ;
    rdfs:comment      "Detects human presence for smart lighting control"@en .

# ── ObservableProperty classes ──

sf:measuresTemperature  a  sosa:ObservableProperty ;
    rdfs:label  "Temperature"@en ;
    rdfs:comment  "Ambient air temperature in degrees Celsius"@en .

sf:measuresHumidity  a  sosa:ObservableProperty ;
    rdfs:label  "Humidity"@en ;
    rdfs:comment  "Relative humidity as a percentage"@en .

sf:measuresCO  a  sosa:ObservableProperty ;
    rdfs:label  "Carbon Monoxide Concentration"@en ;
    rdfs:comment  "CO concentration in parts per million (ppm)"@en .

sf:measuresSmoke  a  sosa:ObservableProperty ;
    rdfs:label  "Smoke Concentration"@en ;
    rdfs:comment  "Smoke particle concentration in ppm"@en .

sf:measuresCombustibleGas  a  sosa:ObservableProperty ;
    rdfs:label  "Combustible Gas Concentration"@en ;
    rdfs:comment  "Combustible gas concentration in ppm"@en .

sf:measuresDistance  a  sosa:ObservableProperty ;
    rdfs:label  "Distance"@en ;
    rdfs:comment  "Distance to nearest obstacle in centimeters"@en .

sf:measuresCount  a  sosa:ObservableProperty ;
    rdfs:label  "Count"@en ;
    rdfs:comment  "Cumulative or per-interval count of items"@en .

sf:measuresOccupancy  a  sosa:ObservableProperty ;
    rdfs:label  "Occupancy"@en ;
    rdfs:comment  "Binary occupancy state (0 = vacant, 1 = occupied)"@en .

sf:measuresLightState  a  sosa:ObservableProperty ;
    rdfs:label  "Light State"@en ;
    rdfs:comment  "Binary light state (0 = off, 1 = on)"@en .

# ── Subsystem grouping ──

sf:Subsystem  a  rdfs:Class .

sf:TempHumiditySubsystem  a  sf:Subsystem ;
    rdfs:label  "Temperature & Humidity Monitoring Subsystem"@en .

sf:LightingSubsystem  a  sf:Subsystem ;
    rdfs:label  "Infrared-Sensing Lighting Subsystem"@en .

sf:GasMonitoringSubsystem  a  sf:Subsystem ;
    rdfs:label  "Hazardous-Gas Monitoring Subsystem"@en .

sf:AGVObstacleSubsystem  a  sf:Subsystem ;
    rdfs:label  "AGV Obstacle Avoidance Subsystem"@en .

sf:CountingSubsystem  a  sf:Subsystem ;
    rdfs:label  "Goods Sensing & Counting Subsystem"@en .

# ── Custom properties for mapping layer ──

sf:belongsToSubsystem  a  rdf:Property ;
    rdfs:label  "belongs to subsystem"@en .

sf:hasUnit  a  rdf:Property ;
    rdfs:label  "has unit"@en .

sf:transportedVia  a  rdf:Property ;
    rdfs:label  "transported via"@en .

# ── AAS digital-twin classes and properties ──

sf:AssetAdministrationShell  a  owl:Class ;
    rdfs:label    "Asset Administration Shell"@en ;
    rdfs:comment  "Digital-twin shell for a factory subsystem"@en .

sf:Submodel  a  owl:Class ;
    rdfs:label    "AAS Submodel"@en ;
    rdfs:comment  "Operational data submodel within an AAS shell"@en .

sf:hasSubmodel  a  rdf:Property ;
    rdfs:domain  sf:AssetAdministrationShell ;
    rdfs:range   sf:Submodel ;
    rdfs:label   "has submodel"@en .

sf:globalAssetId  a  rdf:Property ;
    rdfs:domain  sf:AssetAdministrationShell ;
    rdfs:label   "global asset ID"@en .

sf:semanticId  a  rdf:Property ;
    rdfs:domain  sf:Submodel ;
    rdfs:label   "semantic ID"@en .

sf:hasDevice  a  rdf:Property ;
    rdfs:domain  sf:Submodel ;
    rdfs:label   "has device"@en .

sf:hasObservableProperty  a  rdf:Property ;
    rdfs:domain  sf:Submodel ;
    rdfs:range   sosa:ObservableProperty ;
    rdfs:label   "has observable property"@en .
</file>

<file path="semantic-layer/src/semantic_layer/shapes/observation_shapes.ttl">
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix sosa:  <http://www.w3.org/ns/sosa/> .
@prefix sf:    <http://example.org/smart-factory#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .

# ref: W3C SHACL spec §2.3, SOSA/SSN §5.2

sf:ObservationShape
    a sh:NodeShape ;
    sh:targetClass sosa:Observation ;
    rdfs:comment "Every SOSA Observation must have a sensor, property, numeric result, and timestamp." ;

    sh:property [
        sh:path sosa:madeBySensor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:name "madeBySensor" ;
        sh:message "Observation needs exactly one sosa:madeBySensor (IRI of the sensor device)." ;
    ] ;

    sh:property [
        sh:path sosa:observedProperty ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:name "observedProperty" ;
        sh:message "Observation needs exactly one sosa:observedProperty." ;
    ] ;

    sh:property [
        sh:path sosa:hasSimpleResult ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:name "hasSimpleResult" ;
        sh:message "Observation needs exactly one numeric sosa:hasSimpleResult (xsd:double)." ;
    ] ;

    sh:property [
        sh:path sosa:resultTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:name "resultTime" ;
        sh:message "Observation needs exactly one sosa:resultTime (xsd:dateTime)." ;
    ] .


# Sensor node shape

sf:SensorShape
    a sh:NodeShape ;
    sh:targetObjectsOf sosa:madeBySensor ;

    sh:property [
        sh:path rdf:type ;
        sh:minCount 1 ;
        sh:name "sensorType" ;
        sh:message "Sensor node must have at least one rdf:type triple." ;
    ] .


# ObservableProperty value constraint

sf:KnownPropertyShape
    a sh:NodeShape ;
    sh:targetObjectsOf sosa:observedProperty ;
    sh:property [
        sh:path [ sh:inversePath sosa:observedProperty ] ;
        sh:minCount 1 ;
    ] ;
    sh:pattern "^http://example\\.org/smart-factory#measures" ;
    sh:severity sh:Warning ;
    sh:message "ObservableProperty URI does not match the sf:measures* pattern — might be from a different ontology." .
</file>

<file path="semantic-layer/src/semantic_layer/aas_live_sync.py">
"""

Drop-in: semantic-layer/src/semantic_layer/
"""

from __future__ import annotations

import asyncio
import json
import logging
import uuid
from dataclasses import dataclass, field
from datetime import datetime, timezone
from typing import Any, Optional

import httpx
from rdflib import RDF, XSD, Graph, Literal, Namespace, URIRef

logger = logging.getLogger(__name__)

SF   = Namespace("http://example.org/smart-factory#")
AAS  = Namespace("urn:smart-factory:aas:")
PROV = Namespace("http://www.w3.org/ns/prov#")

_PROPERTY_MAP: dict[str, URIRef] = {
    "temperature":      SF.measuresTemperature,
    "humidity":         SF.measuresHumidity,
    "smoke":            SF.measuresSmoke,
    "co":               SF.measuresCO,
    "combustible_gas":  SF.measuresCombustibleGas,
    "distance":         SF.measuresDistance,
    "count":            SF.measuresCount,
    "occupancy":        SF.measuresOccupancy,
    "light_state":      SF.measuresLightState,
}

_SUBSYSTEM_MAP: dict[str, URIRef] = {
    "temp_humidity": SF.TempHumiditySubsystem,
    "lighting":      SF.LightingSubsystem,
    "gas":           SF.GasMonitoringSubsystem,
    "agv":           SF.AGVObstacleSubsystem,
    "counting":      SF.CountingSubsystem,
}

@dataclass
class LiveDevice:
    """Snapshot of a device seen in the ingest pipeline."""
    device_id: str
    subsystem: str
    protocol: str
    measurement_types: list[str]
    last_seen: datetime = field(default_factory=lambda: datetime.now(timezone.utc))

    @property
    def aas_shell_uri(self) -> URIRef:
        return URIRef(f"{AAS}{self.device_id}")

    @property
    def submodel_uri(self) -> URIRef:
        return URIRef(f"{AAS}{self.device_id}:OperationalData")


@dataclass
class RegistryDiff:
    new_devices: list[LiveDevice] = field(default_factory=list)
    retired_ids: list[str] = field(default_factory=list)
    protocol_changed: list[LiveDevice] = field(default_factory=list)


def _device_to_rdf(device: LiveDevice) -> Graph:
    
    g = Graph()
    g.bind("sf",   SF)
    g.bind("aas",  AAS)
    g.bind("prov", PROV)

    shell = device.aas_shell_uri
    asset = URIRef(f"{SF}{device.device_id}")
    sub   = device.submodel_uri
    now   = Literal(datetime.now(timezone.utc).isoformat(), datatype=XSD.dateTime)

    g.add((shell, RDF.type,         SF.AssetAdministrationShell))
    g.add((shell, SF.globalAssetId, asset))
    g.add((shell, SF.hasSubmodel,   sub))
    g.add((shell, PROV.generatedAtTime, now))
    g.add((shell, SF.registrationSource, Literal("aas_live_sync")))

    g.add((sub, RDF.type,      SF.Submodel))
    g.add((sub, SF.semanticId, _SUBSYSTEM_MAP.get(device.subsystem, SF.UnknownSubsystem)))
    g.add((sub, SF.subsystem,  Literal(device.subsystem)))
    g.add((sub, SF.protocol,   Literal(device.protocol)))
    g.add((sub, SF.hasDevice,  asset))

    for mt in device.measurement_types:
        prop_uri = _PROPERTY_MAP.get(mt)
        if prop_uri:
            g.add((sub, SF.hasObservableProperty, prop_uri))

    g.add((asset, SF.belongsToSubsystem,
           _SUBSYSTEM_MAP.get(device.subsystem, SF.UnknownSubsystem)))
    g.add((asset, SF.transportedVia, Literal(device.protocol)))

    return g


class AASRegistry:

    def __init__(self) -> None:
        self._known: dict[str, LiveDevice] = {}

    def observe(self, device: LiveDevice) -> bool:
        
        existing = self._known.get(device.device_id)
        if existing is None:
            self._known[device.device_id] = device
            logger.info("New device registered: %s", device.device_id)
            return True
        if existing.protocol != device.protocol:
            self._known[device.device_id] = device
            logger.info("Protocol changed for %s: %s → %s",
                        device.device_id, existing.protocol, device.protocol)
            return True
        self._known[device.device_id] = device
        return False

    def diff(self, current_ids: set[str]) -> RegistryDiff:
        known_ids = set(self._known.keys())
        return RegistryDiff(
            new_devices=[],                               
            retired_ids=list(known_ids - current_ids),  
        )

    def all_devices(self) -> list[LiveDevice]:
        return list(self._known.values())

    def get(self, device_id: str) -> Optional[LiveDevice]:
        return self._known.get(device_id)


async def register_device_in_fuseki(device: LiveDevice, endpoint: str) -> bool:
    
    g = _device_to_rdf(device)
    turtle = g.serialize(format="turtle")
    named_graph = f"urn:smart-factory:aas:{device.device_id}"

    url = f"{endpoint}?graph={named_graph}"
    try:
        async with httpx.AsyncClient(timeout=5.0) as client:
            resp = await client.put(
                url,
                content=turtle.encode("utf-8"),
                headers={"Content-Type": "text/turtle"},
            )
        ok = 200 <= resp.status_code < 300
        if ok:
            logger.info("AAS registered in Fuseki: %s", device.device_id)
        else:
            logger.warning("Fuseki PUT failed %d for %s", resp.status_code, device.device_id)
        return ok
    except httpx.HTTPError as exc:
        logger.warning("Fuseki unreachable during AAS registration: %s", exc)
        return False


async def retire_device_in_fuseki(device_id: str, endpoint: str) -> bool:
    
    named_graph = f"urn:smart-factory:aas:{device_id}"
    url = f"{endpoint}?graph={named_graph}"
    try:
        async with httpx.AsyncClient(timeout=5.0) as client:
            resp = await client.delete(url)
        ok = resp.status_code in (200, 204, 404)
        logger.info("AAS retired in Fuseki: %s (status %d)", device_id, resp.status_code)
        return ok
    except httpx.HTTPError as exc:
        logger.warning("Fuseki unreachable during AAS retirement: %s", exc)
        return False


async def watch_loop(
    registry: AASRegistry,
    fuseki_data_endpoint: str,
    poll_interval_seconds: float = 30.0,
) -> None:
    
    logger.info("AAS live-sync watch loop started (interval=%.0fs)", poll_interval_seconds)
    while True:
        await asyncio.sleep(poll_interval_seconds)
        try:
            now = datetime.now(timezone.utc)
            stale_cutoff = poll_interval_seconds * 5
            for device in registry.all_devices():
                age = (now - device.last_seen).total_seconds()
                if age > stale_cutoff:
                    await retire_device_in_fuseki(device.device_id, fuseki_data_endpoint)
        except Exception as exc: 
            logger.error("AAS watch loop error: %s", exc, exc_info=True)
