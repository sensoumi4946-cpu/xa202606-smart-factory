def test_valid_single_measurement_passes():
    g = to_rdf_graph(_make_msg())
    ok, errors = validate_observation_graph(g)
    assert ok, f"Expected valid but got: {errors}"
    assert errors == []


def test_valid_multi_measurement_passes():
    msg = _make_msg(
        measurements=[
